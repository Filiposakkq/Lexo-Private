{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aside",
  "mainBinaryName": "Aside",
  "version": "1.0.0",
  "identifier": "dev.filiposakkq.aside",
  "build": {
    "frontendDist": "../../resources/ui-classic"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Aside",
    "shortDescription": "Translation Manager for Ren'Py",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "resources": {
      "../../resources/ui-classic": "ui",
      "../../resources/packs": "packs"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Czech"]
      }
    }
  }
}
