  "root/game/script.rpy": {
   "sha1": "f248ec0ff467164bd4692a78575f84be5111d6ae",
   "text": "define mc = Character(\"Main [name]\", color=\"#ff0000\")\ndefine js = DynamicCharacter(\"jname\", who_color='#0f0')\ndefine narrator = Character(None)\ndefine bad = Character\ndefine mc = Character(\"Second\")\n\nimage ep1_alias = \"images/bg_cafe.jpg\"\nimage maya happy = \"Maya_Smile\"\nimage maya anim:\n    \"ep1_cafe_maya1\"\n    pause 0.5\n    \"ep1_cafe_maya2\"\n    repeat\nimage comp = Composite((100,100), (0,0), \"bg_cafe\")\nimage comp_blink:\n    \"comp\"\n    pause 1\nlayeredimage eileen:\n    always \"eileen_base\"\nimage hero = \"hero_blink\"\nimage chain1 = \"chain2\"\nimage chain2 = \"chain3\"\nimage chain3 = \"bg_cafe\"\nimage deep = \"sub/Deep.PNG\"\n\nlabel start:\n    scene black\n    scene bg_cafe with fade\n    show maya happy at left\n    show hero at right as hero2\n    mc \"Hello\"\n    show maya anim\n    show eileen happy\n    hide hero2\n    show nonexistent\n    mc \"Middle\"\n    scene ep1_alias\n    show maya happy at center:\n    scene eileen\n    scene missing_one\n    show chain1\n    scene white\n    show comp\n    show deep at truecenter\n    hide chain1\n    mc \"End\"\n"
  },
